# Usluga systemd uruchamiajaca strone (Gunicorn + Django).
# Instalacja: cp deploy/szybypleszew.service /etc/systemd/system/ && systemctl enable --now szybypleszew
[Unit]
Description=Strona szybypleszew.pl (Gunicorn)
After=network.target postgresql.service

[Service]
User=szybypleszew
# grupa www-data: nginx moze laczyc sie z gniazdem Gunicorna
Group=www-data
WorkingDirectory=/home/szybypleszew/app
# /run/szybypleszew tworzy systemd przy starcie uslugi (tam lezy gniazdo gunicorn.sock)
RuntimeDirectory=szybypleszew
# 3 procesy wystarcza z zapasem dla malej strony; serwer ma 4 GB RAM (dzielone z innymi uslugami)
ExecStart=/home/szybypleszew/app/venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind unix:/run/szybypleszew/gunicorn.sock \
    --umask 007 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
